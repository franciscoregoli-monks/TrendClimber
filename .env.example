GOOGLE_API_KEY=your_gemini_api_key_here

# Google Trends — proxies HTTPS opcionales, separados por coma.
# No uses proxies públicos ni desactives la verificación TLS.
# PYTRENDS_HTTPS_PROXIES=https://user:password@proxy.example.com:443

# BigQuery — credenciales ADC o service account
# gcloud auth application-default login  OR  ruta al JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
BQ_PROJECT_ID=mm-trends-agent
BQ_TRENDS_TABLE=mm-trends-agent.010_raw.raw_x_trends
BQ_MIN_LOAD_DATE=2026-08-21
